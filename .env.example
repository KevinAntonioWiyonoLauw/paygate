# ---- Postgres ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=paygate
POSTGRES_PASSWORD=paygate_dev_pw
POSTGRES_DB=paygate

# ---- Backend ----
# Listen address for the Go gateway.
PAYGATE_ADDR=127.0.0.1:8787
# Public base URL, used when building absolute links in the UI.
PAYGATE_PUBLIC_URL=http://127.0.0.1:8787
# HMAC key for session cookies. Generate: openssl rand -hex 32
PAYGATE_JWT_SECRET=change_me_to_a_64_char_hex_string
# 32-byte hex key used to encrypt provider sessions at rest. Generate: openssl rand -hex 32
PAYGATE_ENCRYPTION_KEY=change_me_to_a_64_char_hex_string
# Bootstrap admin, created on first run only.
PAYGATE_ADMIN_USER=admin
PAYGATE_ADMIN_PASSWORD=change_me_min_8_chars

# ---- Shopee provider ----
# Phone number used for OTP login (E.164 or 08xx).
SHOPEE_PHONE=
# Shopee account password, if the account has one. Empty for passwordless.
SHOPEE_PASSWORD=
# Device-risk blob captured from your own browser session.
# Leave empty to fall back to the upstream shared constant (not recommended:
# every install reports the same device and accounts become linkable).
SHOPEE_DEVICE_REPORT=
# Static QRIS payload bound to the store. Filled from the UI after login.
SHOPEE_STATIC_QRIS=
# Polling interval in milliseconds. Lower = faster detection, more API calls.
SHOPEE_POLL_INTERVAL_MS=2000
# How long an order stays payable.
SHOPEE_EXPIRY_SECONDS=900
# Clock skew tolerance when matching transaction time to the order window.
SHOPEE_CLOCK_SKEW_SECONDS=90
# Offset window for the unique-amount allocator.
SHOPEE_MAX_OFFSET=999
# Quarantine after an offset was used, so a late payment cannot collide with a
# freshly created order carrying the same amount.
SHOPEE_OFFSET_COOLDOWN_HOURS=24

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787
